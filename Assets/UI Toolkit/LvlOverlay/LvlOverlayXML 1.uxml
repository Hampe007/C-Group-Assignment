<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UIStyle.uss?fileID=7433441132597879392&amp;guid=ade595b3343210b4186d64ecb9c8b9b6&amp;type=3#UIStyle"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: center; align-content: flex-start; justify-content: flex-start;">
        <ui:VisualElement name="GameOverOverlay" class="overlay" style="visibility: hidden; transition-duration: 1s; transition-timing-function: ease-in;">
            <ui:Label text="GAME OVER" style="-unity-text-align: upper-center; font-size: 60px; margin-bottom: 140px;"/>
            <ui:VisualElement name="ButtonContainer">
                <ui:Button text="RETRY" name="RetryButton"/>
                <ui:Button text="QUIT" name="QuitButton"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ScoreElement" class="scoreRegular" style="flex-grow: 0; background-image: none; align-items: center; justify-content: center; -unity-font-definition: url(&quot;project://database/Assets/Models/UI/Fonts/False.ttf?fileID=12800000&amp;guid=07ea2196493900746a0f2368ed4d182b&amp;type=3#False&quot;); background-position-x: right 10px; background-size: 91% 91%; -unity-background-image-tint-color: rgb(170, 67, 67); width: 100px; position: absolute; top: 35%; bottom: auto;">
            <ui:VisualElement name="ScoreTextContainer" class="scoreText" style="flex-grow: 1;">
                <ui:Label text="SCORE" name="ScoreLabel"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointsTextContainer" class="pointsText" style="flex-grow: 1;">
                <ui:Label text="200" name="PointsLabel"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TopContainer" style="flex-grow: 0; flex-direction: row; font-size: 24px; color: rgb(255, 255, 255); height: 101px; width: 100%; justify-content: center; align-items: center; padding-top: 40px;">
            <ui:VisualElement name="TimerElement" class="timerRegular" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Textures/painted_circle.png?fileID=2800000&amp;guid=4fb4e6af81766bb49be2c57140645bd7&amp;type=3#painted_circle&quot;); align-items: center; justify-content: center; -unity-font-definition: url(&quot;project://database/Assets/Models/UI/Fonts/DigitalNumbers-Regular.ttf?fileID=12800000&amp;guid=2ce092f12c6e24f43a4b04ca071e648c&amp;type=3#DigitalNumbers-Regular&quot;); background-position-x: right 10px; background-size: 91% 91%; -unity-background-image-tint-color: rgb(170, 67, 67);">
                <ui:Label text="00:00" name="TimerLabel"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="GamePausedOverlay" class="overlay" style="visibility: hidden; transition-duration: 0.125s;">
            <ui:Label text="— PAUSED —" style="-unity-text-align: upper-center; font-size: 60px; margin-bottom: 50px;"/>
            <ui:VisualElement name="ButtonContainer">
                <ui:Button text="RESUME" name="ResumeButton"/>
                <ui:Button text="RETRY" name="RetryButton"/>
                <ui:Button text="QUIT" name="QuitButton"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
