:root {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/False.ttf?fileID=12800000&guid=07ea2196493900746a0f2368ed4d182b&type=3#False");
}

#ButtonContainer {
    width: 341px;
}

Button {
    margin-top: 0;
    margin-bottom: 30px;
    background-color: rgba(255, 255, 255, 0);
    font-size: 30px;
    color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/UI%20Toolkit/Textures/cool_btn.png?fileID=2800000&guid=f299bf55f89787744ac95f8b60f2a629&type=3#cool_btn");
    -unity-background-scale-mode: scale-to-fit;
    background-size: 100% 125%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    opacity: 0.95;
    transition-duration: 0.125s;
}

Button:focus {
    color: rgb(5, 5, 5);
    opacity: 1;
    translate: 0 0;
    scale: 1.025 1.025;
}

Button:hover {
    color: rgb(5, 5, 5);
    opacity: 1;
    translate: -3px -3px;
    scale: 1.025 1.025;
}

.timerEmphasized {
    width: 200px;
    height: 200px;
    font-size: 45px;
}

.timerRegular {
    width: 130px;
    height: 130px;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out-sine;
    font-size: 20px;
}

.timerFlash {
    color: rgb(248, 48, 48);
    transition-timing-function: ease-out;
    transition-duration: 0.5s;
    width: 130px;
    height: 130px;
    font-size: 20px;
}

.overlay {
    position: absolute;
    align-items: center;
    justify-content: center;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.325);
    background-image: none;
    visibility: hidden;
}
